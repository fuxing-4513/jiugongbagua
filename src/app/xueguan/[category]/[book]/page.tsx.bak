import type { Metadata } from 'next'
import Link from 'next/link'
import { notFound } from 'next/navigation'
import { findCategory } from '@/data/xueguan/categories'
import type { BookMeta } from '@/data/xueguan/categories'
import { bookCatalog, findBook } from '@/data/xueguan/books'
import { getBookContent } from '@/data/xueguan/content/content-registry'

interface Props {
  params: Promise<{ category: string; book: string }>
}

export async function generateStaticParams() {
  return bookCatalog.map(b => ({
    category: b.category,
    book: b.id,
  }))
}

export async function generateMetadata({ params }: Props): Promise<Metadata> {
  const { book: bookId } = await params
  const book = findBook(bookId)
  if (!book) return { title: '典籍未找到 | 易学书馆' }
  const cat = findCategory(book.category)
  const words = book.estimatedChars ? `（约${(book.estimatedChars / 1000).toFixed(0)}千字）` : ''
  return {
    title: `${book.title} - ${cat?.name || ''} | 易学书馆 | 九宫八卦`,
    description: `${book.title} · ${book.author} · ${book.dynasty} · ${book.summary}${words}`,
  }
}

export default async function BookPage({ params }: Props) {
  const { book: bookId } = await params
  const book = findBook(bookId)
  if (!book) notFound()

  const cat = findCategory(book.category)
  const relatedBooks = book.related
    ?.map(id => findBook(id))
    .filter((b): b is BookMeta => b !== undefined) || []

  const content = getBookContent(bookId)
  const hasFullText = content && content.chapters.length > 0

  return (
    <div className="max-w-4xl mx-auto px-4 py-20">
      {/* 面包屑 */}
      <div className="mb-8 text-sm text-gray-400">
        <Link href="/xueguan" className="hover:text-gold-500 transition-colors">易学书馆</Link>
        <span className="mx-2">/</span>
        {cat && (
          <>
            <Link href={`/xueguan/${cat.id}`} className="hover:text-gold-500 transition-colors">
              {cat.emoji} {cat.name}
            </Link>
            <span className="mx-2">/</span>
          </>
        )}
        <span className="text-gray-600">{book.title}</span>
      </div>

      {/* 标题区域 */}
      <div className="mb-8">
        <h1 className="text-3xl font-bold text-gray-800 font-serif mb-2">{book.title}</h1>
        <div className="flex flex-wrap items-center gap-3 text-sm text-gray-500">
          <span className="bg-gray-50 px-2 py-0.5 rounded">{book.dynasty}</span>
          <span className="bg-gray-50 px-2 py-0.5 rounded">{book.author}</span>
          <span className="bg-gray-50 px-2 py-0.5 rounded">{book.volumes}</span>
          {book.estimatedChars ? (
            <span className="bg-gray-50 px-2 py-0.5 rounded">
              ～{(book.estimatedChars / 1000).toFixed(0)}千字
            </span>
          ) : null}
          {book.isComplete && (
            <span className="bg-jade-50 text-jade-600 px-2 py-0.5 rounded font-medium">✅ 完整收录</span>
          )}
          {!book.isComplete && (
            <span className="text-gray-300 text-xs">⏳ 部分收录</span>
          )}
        </div>
      </div>

      {/* 关键词标签 */}
      <div className="mb-8 flex flex-wrap gap-2">
        {book.keywords.map(kw => (
          <span key={kw} className="text-xs bg-gray-50 text-gray-500 px-2.5 py-1 rounded-full border border-gray-100">
            #{kw}
          </span>
        ))}
      </div>

      {/* 简介 */}
      <div className="mb-10">
        <h2 className="text-lg font-bold text-gray-700 mb-3 flex items-center gap-2">
          <span>📖</span> 典籍简介
        </h2>
        <div className="bg-white border border-gray-100 rounded-xl p-6">
          <p className="text-gray-600 leading-relaxed whitespace-pre-line">
            {book.description}
          </p>
        </div>
      </div>

      {/* 原文内容（如果存在） */}
      {hasFullText && (
        <div className="mb-10">
          <h2 className="text-lg font-bold text-gray-700 mb-3 flex items-center gap-2">
            <span>📜</span> 原文阅读
            <span className="text-xs text-gray-400 font-normal">（{content.chapters.length} 节）</span>
          </h2>
          <div className="space-y-4">
            {content.chapters.map((ch, i) => (
              <details key={ch.id} className="group bg-white border border-gray-100 rounded-xl overflow-hidden">
                <summary className="px-5 py-3 text-sm font-medium text-gray-700 cursor-pointer hover:bg-gray-50 hover:text-gold-600 transition-colors flex items-center gap-2">
                  <span className="text-gray-300 group-open:text-gold-400 transition-colors">
                    {i + 1}.
                  </span>
                  <span>{ch.title}</span>
                  <span className="ml-auto text-gray-300 group-open:rotate-180 transition-transform text-xs">▼</span>
                </summary>
                <div className="px-5 pb-5 pt-2 border-t border-gray-50">
                  <div className="prose prose-sm max-w-none text-gray-600 leading-relaxed whitespace-pre-line">
                    {ch.content}
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      )}

      {/* 章节概览（原文尚在整理中时展示） */}
      {!hasFullText && book.chapterOutline && book.chapterOutline.length > 0 && (
        <div className="mb-10">
          <h2 className="text-lg font-bold text-gray-700 mb-3 flex items-center gap-2">
            <span>📋</span> 章节概览
          </h2>
          <div className="bg-white border border-gray-100 rounded-xl p-5">
            <ul className="space-y-2">
              {book.chapterOutline.map(ch => (
                <li key={ch.id} className="text-sm text-gray-500 flex items-start gap-2">
                  <span className="text-gold-400 mt-0.5">▸</span>
                  <div>
                    <span className="text-gray-700 font-medium">{ch.title}</span>
                    {ch.summary && <span className="text-gray-400 ml-1">— {ch.summary}</span>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}

      {/* 原文整理中提示 */}
      {!hasFullText && (
        <div className="mb-10 bg-amber-50 border border-amber-100 rounded-xl p-5 text-center">
          <p className="text-3xl mb-2">📝</p>
          <p className="text-sm text-amber-700 font-medium mb-1">原文持续整理中</p>
          <p className="text-xs text-amber-500">本书的原文内容正在逐章录入与清洗中，敬请期待后续更新。</p>
        </div>
      )}

      {/* 关联书籍 */}
      {relatedBooks.length > 0 && (
        <div className="mb-10">
          <h2 className="text-lg font-bold text-gray-700 mb-3 flex items-center gap-2">
            <span>🔗</span> 关联典籍
          </h2>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
            {relatedBooks.map(rb => (
              <Link
                key={rb.id}
                href={`/xueguan/${rb.category}/${rb.id}`}
                className="flex items-center gap-3 bg-white border border-gray-100 rounded-lg p-4 hover:shadow-sm hover:border-gold-200 transition-all group"
              >
                <span className="text-2xl text-gray-200">{'📖'}</span>
                <div className="flex-1 min-w-0">
                  <div className="text-sm font-medium text-gray-700 group-hover:text-gold-600 transition-colors">
                    {rb.title}
                  </div>
                  <div className="text-xs text-gray-400">{rb.author} · {rb.dynasty}</div>
                </div>
              </Link>
            ))}
          </div>
        </div>
      )}

      {/* 底部导航 */}
      <div className="mt-12 pt-6 border-t border-gray-100">
        <div className="flex items-center justify-between">
          <Link
            href={`/xueguan/${book.category}`}
            className="text-sm text-gold-500 hover:text-gold-600 transition-colors"
          >
            ← 返回 {cat?.name || '分类'}
          </Link>
          <Link
            href="/xueguan"
            className="text-sm text-gray-400 hover:text-gold-500 transition-colors"
          >
            返回书馆首页
          </Link>
        </div>
      </div>

      {/* JSON-LD 结构化数据 */}
      <script
        type="application/ld+json"
        dangerouslySetInnerHTML={{
          __html: JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'Book',
            name: book.title,
            author: book.author,
            description: book.summary,
            keywords: book.keywords.join(', '),
            numberOfPages: book.volumes,
            genre: cat?.name || '玄学',
            ...(hasFullText ? { hasPart: content.chapters.map((ch, i) => ({
              '@type': 'Chapter',
              name: ch.title,
              position: i + 1,
            }))} : {}),
          })
        }}
      />
    </div>
  )
}
