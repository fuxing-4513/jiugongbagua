{
  "name": "jiugong-bagua",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postbuild": "node scripts/inject-security-headers.mjs && node -e \"var f=require('fs');f.writeFileSync('out/CNAME','www.jiugongbagua.com');f.writeFileSync('out/.nojekyll','')\"",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run build && npm run postbuild && npx gh-pages -d out --no-history",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1 backup",
    "restore": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1 list",
    "stars": "node scripts/generate-stars.js"
  },
  "dependencies": {
    "@cometpisces/tarot-kit": "^0.2.0",
    "bazi": "^0.0.9",
    "dompurify": "^3.4.11",
    "iconv-lite": "^0.7.2",
    "iztro": "^2.6.0",
    "lunar-typescript": "^1.8.6",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-iztro": "^1.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5"
  }
}
