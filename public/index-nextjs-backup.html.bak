<style>
.aisage-float-btn {
  position: fixed;
  bottom: 24px;
  right: 24px;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: linear-gradient(135deg, #059669, #047857);
  color: white;
  border: 2px solid rgba(5, 150, 105, 0.5);
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  cursor: pointer;
  font-size: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
  transition: all 0.3s ease;
}
.aisage-float-btn:hover { transform: scale(1.1); }
.aisage-float-btn.open { transform: rotate(45deg); }
.aisage-modal {
  display: none;
  position: fixed;
  bottom: 90px;
  right: 24px;
  width: 380px;
  height: 520px;
  border-radius: 16px;
  overflow: hidden;
  z-index: 99998;
  border: 1px solid rgba(5, 150, 105, 0.3);
  background: #111827;
  flex-direction: column;
}
.aisage-modal.open { display: flex; }
.aisage-modal .modal-header {
  background: linear-gradient(135deg, #065f46, #047857);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  cursor: move;
}
.aisage-modal .modal-header .title {
  display: flex;
  align-items: center;
  gap: 8px;
}
.aisage-modal .modal-header .title span:first-child { font-size: 20px; }
.aisage-modal .modal-header .title .info p:first-child {
  font-size: 13px;
  font-weight: 600;
  color: #a7f3d0;
}
.aisage-modal .modal-header .title .info p:last-child {
  font-size: 10px;
  color: rgba(167, 243, 208, 0.6);
}
.aisage-modal .modal-header .close-btn {
  background: none;
  border: none;
  color: #a7f3d0;
  font-size: 20px;
  cursor: pointer;
  padding: 4px;
  line-height: 1;
}
.aisage-modal .modal-messages {
  flex: 1;
  overflow-y: auto;
  padding: 12px 16px;
  background: rgba(17, 24, 39, 0.95);
}
.aisage-modal .modal-input-area {
  background: rgba(17, 24, 39, 0.95);
  border-top: 1px solid rgba(55, 65, 81, 0.6);
  padding: 8px 12px 12px;
  flex-shrink: 0;
}
.aisage-modal .topic-row {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  margin-bottom: 8px;
  padding-bottom: 2px;
}
.aisage-modal .topic-row::-webkit-scrollbar { height: 0; }
.aisage-modal .topic-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(31, 41, 55, 0.7);
  border: 1px solid rgba(55, 65, 81, 0.5);
  color: #9ca3af;
  font-size: 11px;
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
}
.aisage-modal .topic-btn:hover { border-color: rgba(5,150,105,0.4); color: #6ee7b7; background: rgba(5,150,105,0.1); }
.aisage-modal .topic-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.aisage-modal .input-row {
  display: flex;
  gap: 8px;
}
.aisage-modal .input-row input {
  flex: 1;
  background: rgba(31, 41, 55, 0.7);
  border: 1px solid rgba(55, 65, 81, 0.5);
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 14px;
  color: #e5e7eb;
  outline: none;
}
.aisage-modal .input-row input:focus { border-color: rgba(5,150,105,0.5); }
.aisage-modal .input-row input:disabled { opacity: 0.5; }
.aisage-modal .input-row button {
  padding: 8px 16px;
  border-radius: 8px;
  background: rgba(5,150,105,0.2);
  color: #34d399;
  border: 1px solid rgba(5,150,105,0.3);
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  align-items: center;
}
.aisage-modal .input-row button:hover { background: rgba(5,150,105,0.3); }
.aisage-modal .input-row button:disabled { opacity: 0.4; cursor: not-allowed; }
.aisage-modal .footer-note {
  text-align: center;
  font-size: 9px;
  color: #4b5563;
  margin-top: 6px;
}
.modal-msg { margin-bottom: 8px; }
.modal-msg .bubble {
  max-width: 85%;
  border-radius: 12px;
  padding: 8px 12px;
  line-height: 1.5;
}
.modal-msg .bubble.user {
  background: rgba(5,150,105,0.2);
  border: 1px solid rgba(5,150,105,0.3);
  color: #a7f3d0;
  margin-left: auto;
}
.modal-msg .bubble.ai {
  background: rgba(31, 41, 55, 0.7);
  border: 1px solid rgba(55, 65, 81, 0.5);
  color: #e5e7eb;
}
.modal-msg .bubble .sender {
  font-size: 11px;
  margin-bottom: 2px;
}
.modal-msg .bubble .sender .badge {
  font-size: 8px;
  padding: 1px 4px;
  border-radius: 4px;
  background: rgba(5,150,105,0.2);
  color: #34d399;
  border: 1px solid rgba(5,150,105,0.3);
  margin-left: 4px;
}
.modal-msg .bubble .text { font-size: 13px; }
.modal-msg .bubble .text p { margin: 0; }
.modal-msg .bubble .text br { display: block; content: ""; margin: 4px 0; }
.loading-dots {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 8px 12px;
}
.loading-dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #34d399;
  display: inline-block;
}
.loading-dots .l1 { animation: pulse 1s infinite; }
.loading-dots .l2 { animation: pulse 1s infinite 0.2s; }
.loading-dots .l3 { animation: pulse 1s infinite 0.4s; }
@keyframes pulse { 0%,100%{opacity:0.3} 50%{opacity:1} }
.error-msg {
  text-align: center;
  padding: 6px 12px;
  margin: 8px auto;
  background: rgba(220,38,38,0.2);
  border: 1px solid rgba(220,38,38,0.3);
  border-radius: 8px;
  display: inline-block;
  width: 100%;
}
.error-msg p { font-size: 11px; color: #f87171; margin: 0; }
@media (max-width: 480px) {
  .aisage-modal { width: calc(100vw - 32px); height: 60vh; right: 16px; bottom: 80px; }
}
</style>
<button class="aisage-float-btn" id="aisageBtn" onclick="toggleAisage()">🧿</button>
<div class="aisage-modal" id="aisageModal">
  <div class="modal-header">
    <div class="title">
      <span>🧿</span>
      <div class="info">
        <p>九宫先生</p>
        <p>八字·紫微·奇门·六爻·姓名·风水</p>
      </div>
    </div>
    <button class="close-btn" onclick="toggleAisage()">✕</button>
  </div>
  <div class="modal-messages" id="aisageMessages"><div class="flex justify-start modal-msg"><div class="bubble ai"><div class="sender">🧿 九宫先生 <span class="badge">全科</span></div><div class="text"><p>你好！我是九宫先生，精通八字、紫微斗数、奇门遁甲、六爻、梅花易数、姓名学、风水堪舆等多个玄学领域。</p><br/><p>你可以问我任何问题，比如：<br/>• "我最近事业不顺，帮我看看？"<br/>• "我适合改名吗？"<br/>• "这个项目能成吗？"<br/>• "帮我分析一下风水布局"<br/>• "周公解梦——梦见掉牙齿"</p></div></div></div></div>
  <div class="modal-input-area">
    <div class="topic-row" id="quickTopics"></div>
    <div class="input-row">
      <input type="text" id="aisageInput" placeholder="问一个玄学问题..." autocomplete="off" disabled="disabled" />
      <button id="aisageSendBtn" disabled="disabled">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>
    <div class="footer-note">AI 回复仅供参考 · 命运在自己手中 🪷</div>
  </div>
</div>
<script>
(function() {
  var API_URL = window.location.origin;

  var QUICK_TOPICS = [
    {e:'📜',l:'八字分析',p:'给我介绍一下四柱八字是怎么看命的，每柱代表什么'},
    {e:'⭐',l:'紫微斗数',p:'紫微斗数怎么看一个人的财运？主要看哪个宫位？'},
    {e:'☯',l:'六爻占卜',p:'六爻占卜是怎么起卦的？爻辞怎么看吉凶？'},
    {e:'🌀',l:'奇门遁甲',p:'奇门遁甲中的八门各自代表什么？'},
    {e:'🌸',l:'梅花易数',p:'梅花易数的时间起卦法是怎么算的？'},
    {e:'📝',l:'姓名学',p:'姓名五格剖象法中，人格和地格哪个更重要？'},
    {e:'🧭',l:'风水布局',p:'居家风水入门——客厅和卧室有哪些基本禁忌？'},
  ];

  var topicsEl = document.getElementById('quickTopics');
  var messagesEl = document.getElementById('aisageMessages');
  var inputEl = document.getElementById('aisageInput');
  var sendBtn = document.getElementById('aisageSendBtn');
  var modal = document.getElementById('aisageModal');

  var loading = false;
  var msgCount = 1; // 已有初始消息

  // 渲染快捷话题
  QUICK_TOPICS.forEach(function(t) {
    var btn = document.createElement('button');
    btn.className = 'topic-btn';
    btn.innerHTML = '<span>' + t.e + '</span> ' + t.l;
    btn.onclick = function() { sendMessage(t.p); };
    topicsEl.appendChild(btn);
  });

  function toggleAisage() {
    var btn = document.getElementById('aisageBtn');
    var isOpen = modal.classList.toggle('open');
    btn.classList.toggle('open', isOpen);
    if (isOpen) {
      setTimeoutwindow.addEventListener('load', function() { inputEl.disabled = false; inputEl.focus(); }, 300);
    } else {
      inputEl.disabled = true;
    }
  }

  // 挂载到全局
  window.toggleAisage = toggleAisage;

  function escapeHtml(text) {
    return text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function formatContent(text) {
    var lines = text.split('\n');
    var out = '';
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i].trim();
      if (!line) { out += '<br/>'; continue; }
      out += '<p>' + escapeHtml(line) + '</p>';
    }
    return out;
  }

  function renderLoading(v) {
    var existing = document.getElementById('loadingMsg');
    if (existing) existing.remove();
    if (!v) return;
    var div = document.createElement('div');
    div.id = 'loadingMsg';
    div.className = 'flex justify-start';
    div.innerHTML = '<div class="loading-dots"><span class="l1"></span><span class="l2"></span><span class="l3"></span></div>';
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function renderError(msg) {
    var existing = document.getElementById('errorMsg');
    if (existing) existing.remove();
    if (!msg) return;
    var div = document.createElement('div');
    div.id = 'errorMsg';
    div.className = 'error-msg';
    div.innerHTML = '<p>⚠️ ' + escapeHtml(msg) + '</p>';
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function addMessage(role, content, tag) {
    var div = document.createElement('div');
    div.className = 'flex justify-start modal-msg';
    if (role === 'user') {
      div.className = 'flex justify-end modal-msg';
      div.innerHTML = '<div class="bubble user"><div class="sender">👤 你</div><div class="text">' + formatContent(content) + '</div></div>';
    } else {
      var badge = tag ? '<span class="badge">' + escapeHtml(tag) + '</span>' : '';
      div.innerHTML = '<div class="bubble ai"><div class="sender">🧿 九宫先生 ' + badge + '</div><div class="text">' + formatContent(content) + '</div></div>';
    }
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function setUIState(disabled) {
    inputEl.disabled = disabled || !inputEl.value.trim();
    sendBtn.disabled = disabled || !inputEl.value.trim();
    topicsEl.querySelectorAll('button').forEach(function(b) { b.disabled = disabled; });
  }

  async function sendMessage(text) {
    var trimmed = text.trim();
    if (!trimmed || loading) return;
    loading = true;
    addMessage('user', trimmed);
    inputEl.value = '';
    setUIState(true);
    renderLoading(true);
    renderError('');
    var btn = document.getElementById('aisageBtn');

    try {
      var res = await fetch(API_URL + '/aisage/chat', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({messages: [{role:'user',content:trimmed}]})
      });
      if (!res.ok) throw new Error('请求失败(状态'+res.status+'), URL:'+API_URL+'/aisage/chat');
      var data = await res.json();
      if (data.reply) {
        addMessage('assistant', data.reply, '全科');
      } else {
        throw new Error('AI 回复为空');
      }
      btn.textContent = '🧿';
    } catch (err) {
      renderError(err.message);
      btn.textContent = '⚠️';
    } finally {
      loading = false;
      renderLoading(false);
      setUIState(false);
      inputEl.disabled = false;
      inputEl.focus();
    }
  }

  // 事件绑定
  sendBtn.onclick = function() { sendMessage(inputEl.value); };
  inputEl.onkeydown = function(e) { if (e.key === 'Enter') { e.preventDefault(); sendMessage(inputEl.value); } };
  inputEl.oninput = function() { setUIState(false); };
})();
</script>

</body></html>